# Copy to .env for local development. In production these come from Docker Swarm
# secrets mounted at /run/secrets/<NAME> (see config.ts — secrets take precedence).

# Provider auth. All LLM calls use OpenAI via the `openai` SDK (shopping loop,
# vision, seeder term mapping).
OPENAI_API_KEY=sk-...

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-...

# Your Oda.com login (used to (re)authenticate the mcp-oda cookie session)
ODA_USER=you@example.com
ODA_PASS=your-oda-password

# Numeric Telegram user id(s) allowed to drive the bot — comma-separated for
# more than one. ONLY these users may use it. Find an id via @userinfobot.
ALLOWED_TELEGRAM_USER_ID=123456789,987654321

# Optional: model + mcp-oda data dir (defaults shown).
ODA_AGENT_MODEL=gpt-4.1-mini
MCP_ODA_DATA_DIR=./.mcp-oda

# OpenAI models (defaults shown).
#   OPENAI_CHAT_MODEL   — shopping loop + seeder term mapping → gpt-4.1-mini
#   OPENAI_VISION_MODEL — image reading (vision step)            → gpt-4.1-mini
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
